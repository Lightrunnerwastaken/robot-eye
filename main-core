import math, cv2, numpy as np, pygame
import mediapipe as mp

# -------------------- Config --------------------
W, H = 700, 700             # Renderfenster
N_LAMELLAE = 48             # Anzahl Lamellen
R_OUT = 300                 # äußerer Radius (optischer Ring)
R_IRIS = 140                # Irisradius (Lamellenende)
R_PUPIL = 60                # Pupillenradius
PUPIL_TRAVEL = 70           # wie weit die Pupille wandern darf
THICK_BASE = 6              # Grunddicke Lamellen
THICK_GAIN = 14             # Dicke-Zunahme in Blickrichtung
EMA_ALPHA = 0.25            # Glättung (0..1) für Blickvektor
DEADZONE = 0.01             # tote Zone gegen Zittern
# ------------------------------------------------

def ema(prev, cur, a=EMA_ALPHA): return a*cur + (1-a)*prev

def main():
    # --- Webcam & FaceMesh ---
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        raise RuntimeError("Keine Webcam gefunden.")
    mp_face = mp.solutions.face_mesh.FaceMesh(
        refine_landmarks=True, max_num_faces=1
    )

    # --- Pygame Render ---
    pygame.init()
    screen = pygame.display.set_mode((W, H))
    clock = pygame.time.Clock()
    cx, cy = W//2, H//2

    # Blickvektor (in -1..1 normiert, x rechts positiv, y oben positiv)
    vx, vy = 0.0, 0.0

    while True:
        # Events
        for e in pygame.event.get():
            if e.type == pygame.QUIT:
                cap.release(); pygame.quit(); return

        # Kamera lesen
        ok, frame = cap.read()
        if not ok:
            continue
        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        res = mp_face.process(rgb)

        # Blickvektor aus Gesichtszentrum (simple Heuristik)
        if res.multi_face_landmarks:
            pts = res.multi_face_landmarks[0].landmark
            gx = sum(p.x for p in pts) / len(pts)  # 0..1
            gy = sum(p.y for p in pts) / len(pts)  # 0..1

            # Bildzentrum = (0.5, 0.5). Positive vx nach rechts, vy nach oben
            target_vx = (0.5 - gx) * 2.0
            target_vy = (gy - 0.5) * 2.0

            # Deadzone + Normierung
            mag = math.hypot(target_vx, target_vy)
            if mag < DEADZONE:
                target_vx = target_vy = 0.0
            elif mag > 1.0:
                target_vx /= mag; target_vy /= mag

            # Glätten
            vx = ema(vx, target_vx)
            vy = ema(vy, target_vy)
        else:
            # Kein Gesicht: langsam zur Mitte zurück
            vx = ema(vx, 0.0, 0.1)
            vy = ema(vy, 0.0, 0.1)

        # --- Zeichnen ---
        screen.fill((8, 10, 18))

        # Außenring (weiß leuchtend)
        pygame.draw.circle(screen, (255, 255, 255), (cx, cy), R_OUT, 18)

        # Blickwinkel für Lamellen-Modulation
        theta0 = math.atan2(vy, vx) if (vx or vy) else 0.0

        # Lamellen (radiale Linien mit variabler Dicke)
        for i in range(N_LAMELLAE):
            th = i * 2*math.pi / N_LAMELLAE
            thick = max(1, THICK_BASE + THICK_GAIN * math.cos(th - theta0))
            x1 = cx + R_PUPIL * math.cos(th)
            y1 = cy + R_PUPIL * math.sin(th)
            x2 = cx + R_IRIS  * math.cos(th)
            y2 = cy + R_IRIS  * math.sin(th)
            pygame.draw.line(screen, (40, 170, 255), (x1, y1), (x2, y2), int(thick))

        # Pupille (versetzt in Blickrichtung)
        px = cx + PUPIL_TRAVEL * vx
        py = cy + PUPIL_TRAVEL * vy
        pygame.draw.circle(screen, (0, 25, 60), (int(px), int(py)), R_PUPIL)

        pygame.display.flip()
        clock.tick(60)  # Ziel: 60 FPS

if __name__ == "__main__":
    main()
